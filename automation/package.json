{
  "name": "kutumbsetu-automation",
  "version": "1.0.0",
  "description": "Appium and WebdriverIO Mobile Test Automation Suite for KutumbSetu",
  "main": "config/test-runner.js",
  "scripts": {
    "test": "wdio run config/wdio.android.conf.js",
    "test:standalone": "node config/test-runner.js",
    "test:login": "wdio run config/wdio.android.conf.js --spec test/specs/login_flow.spec.js",
    "test:launch": "wdio run config/wdio.android.conf.js --spec test/specs/app_launch.spec.js"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "flutter",
    "mobile-automation",
    "android",
    "kutumbsetu"
  ],
  "author": "KutumbSetu Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "webdriverio": "^9.31.5"
  },
  "devDependencies": {
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2"
  }
}
